# ===== Məcburi =====
MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=car_advisor_portal

# AI servisinin (ai-server) ünvanı və onun SERVICE_TOKEN dəyəri (hər iki tərəfdə EYNİ olmalıdır)
AI_SERVICE_URL=http://localhost:3000
AI_SERVICE_TOKEN=buraya_ai_serverdeki_SERVICE_TOKEN

# Admin panelinə girə bilən email-lər (vergüllə)
ADMIN_EMAILS=sen@example.com

# ===== Email (production-da məcburi) =====
# RESEND_API_KEY=re_...
# MAIL_FROM=Car Advisor <no-reply@senin-saytin.az>
# MAIL_REPLY_TO=

# ===== Ünvanlar =====
# Panelin (frontend) ünvanı: dəyişdirici sorğular yalnız buradan qəbul olunur (vergüllə bir neçə)
ALLOWED_ORIGINS=http://localhost:3001
# Müştəriyə göstərilən AI servisi ünvanı (curl nümunəsi üçün)
# PUBLIC_ADVISOR_URL=https://api.senin-saytin.az
# Vidjet scripti buradan yüklənir: <script src=".../widget.js">
# PUBLIC_PORTAL_URL=https://portal.senin-saytin.az

# ===== Kanallar (Telegram/WhatsApp sirlərinin şifrələnməsi) =====
# Ən azı 32 simvol: openssl rand -hex 32
# CHANNEL_SECRET_KEY=

# ===== Operatorlara Telegram bildirişi (ixtiyari) =====
# @BotFather-də ayrıca bot yarat (məs. @SeninSayt_alerts_bot) və tokenini bura yaz.
# Operatorlar paneldə "Telegram-da bildiriş al" düyməsi ilə özləri bağlayır. PUBLIC_PORTAL_URL https olmalıdır.
# Bu bot müştərilərin öz Telegram botlarından ayrıdır: yalnız operatorlara xəbər göndərir.
# NOTIFY_TELEGRAM_TOKEN=

# ===== Digər (ixtiyari) =====
# PORT=4000
# NODE_ENV=production
# BRAND_NAME=Hazırcavab
# BRAND_URL=https://senin-saytin.az
# SESSION_DAYS=30
# Admin sessiyası neçə saat yaşayır (defolt 12)
# ADMIN_SESSION_HOURS=12
# Admin üçün iki addımlı giriş (2FA): required = qurmadan admin panel açılmır. Defolt: production-da CHANNEL_SECRET_KEY varsa required.
# ADMIN_2FA=required
# COOKIE_SECURE=1          # defolt: production-da 1
# TRUST_PROXY=1            # reverse proxy (Render, Nginx) arxasında 1
# REPORTS=off              # aylıq hesabat emailləri; çox serverdə yalnız birində işləsin
# WA_DEBUG=1               # WhatsApp mesaj qərarlarını konsola yazır
# LIVE_ABSENT_MS=120000
# LIVE_MAIL_GAP_MS=600000
